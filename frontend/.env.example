# Spark Radar — Frontend Environment Configuration Example
# Project: spark-radar-513115 | Production Host: https://spark-radar-saas.vercel.app

# Deployed Backend API Base URL (FastAPI backend on Render)
VITE_API_BASE_URL="https://spark-radar-api.onrender.com"

# Google OAuth 2.0 Web Client ID (Google Cloud project: spark-radar-513115)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# NOTE: Never put client secrets in frontend variables. Only the public Client ID is exposed to the browser.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
