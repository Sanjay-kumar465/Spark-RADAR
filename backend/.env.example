# Spark Radar Environment Configuration
PROJECT_NAME="Spark Radar"
API_V1_STR="/api/v1"

# Production Security: Change to a high-entropy 64-character secret in production
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database: SQLite default or PostgreSQL connection string
# Examples:
# SQLite: sqlite:///./spark_radar.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/spark_radar
DATABASE_URL="sqlite:///./spark_radar.db"

# Storage: Absolute or relative directory for encrypted workspace uploads
STORAGE_DIR="./storage"

# Maximum upload size in bytes (10MB default)
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate Limiter: Window in seconds and max requests per window for auth endpoints
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=60

# Google OAuth 2.0 Credentials (Get from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

