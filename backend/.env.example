# Spark Radar — Backend Environment Configuration Example
# Project: spark-radar-513115 | Production Frontend: https://spark-radar-saas.vercel.app

PROJECT_NAME="Spark Radar"
API_V1_STR="/api/v1"

# Production Security: Set a high-entropy 64-character random string in production
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database: SQLite default (local dev) or PostgreSQL connection string (production)
# SQLite: sqlite:///./spark_radar.db
# PostgreSQL: postgresql+psycopg2://user:password@hostname:5432/spark_radar
DATABASE_URL="sqlite:///./spark_radar.db"

# Storage: Directory for encrypted workspace document uploads
STORAGE_DIR="./storage"

# Maximum document upload size in bytes (10MB default)
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate Limiter: Window in seconds and max requests per window for auth endpoints
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=60

# Production Frontend URL
FRONTEND_URL="https://spark-radar-saas.vercel.app/"

# Production Allowed CORS Origins (comma-separated or JSON array)
BACKEND_CORS_ORIGINS="https://spark-radar-saas.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Google OAuth 2.0 Credentials (Google Cloud project: spark-radar-513115)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# NOTE: The client ID is verified on the backend to validate token audience.
# The Client Secret is NOT required because Google Identity Services uses direct OpenID Connect ID token verification.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
